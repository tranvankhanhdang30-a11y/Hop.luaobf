local E = ""

local K = "Td9!xQ"

local function D(s)
\tlocal ok, decoded = pcall(function()
\t\treturn (game:GetService("HttpService")):Base64Decode(s)
\tend)
\tif not ok or not decoded then
\t\terror("Khong giai ma duoc script")
\tend

\tlocal out = {}
\tfor i = 1, #decoded do
\t\tout[i] = string.char(
\t\t\tbit32.bxor(
\t\t\t\tstring.byte(decoded, i),
\t\t\t\tstring.byte(K, ((i - 1) % #K) + 1)
\t\t\t)
\t\t)
\tend

\treturn table.concat(out)
end

local src = D(E)

local fn, err = loadstring(src)
if not fn then
\terror("Loi load script: " .. tostring(err))
end

fn()
